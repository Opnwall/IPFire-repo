use strict;
use warnings;
require '/var/ipfire/general-functions.pl';
require '/var/ipfire/captive-lib.pl';
my $state_lock = Captive::lock();
my %clients;
Captive::read_rows('/var/ipfire/captive/clients', \%clients);
my $changed = 0;
for my $key (keys %clients) {
    my $row = $clients{$key};
    next if ($row->[3] // '') eq '0';
    next unless ($row->[2] // '') =~ /^\d+$/ && ($row->[3] // '') =~ /^\d+$/;
    if ($row->[2] + $row->[3] <= time()) {
        General::log('Captive', "Expired authorization for $row->[1]");
        delete $clients{$key};
        $changed = 1;
    }
}
if ($changed) { Captive::write_rows('/var/ipfire/captive/clients', \%clients); }
# Also repairs rules after an interrupted transaction; retain native scheduler.
exit(Captive::reload() ? 0 : 1);
